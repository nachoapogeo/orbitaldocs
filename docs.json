{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Orbital Supply Docs",
  "font": {
    "headings": "Questrial",
    "body": "Inter"
  },
  "colors": {
    "primary": "#1464FF",
    "light": "#1464FF",
    "dark": "#1464FF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.orbital.supply"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Orbital Social",
            "pages": [
              "social-media/overview",
              "social-media/getting-started",
              "social-media/variables",
              "social-media/theming",
              "social-media/typography",
              "social-media/light-dark-mode",
              "social-media/components",
              "social-media/editor",
              "social-media/changelog"
            ]
          },
          {
            "group": "Orbital Branding",
            "pages": [
              "brand-book/overview",
              "brand-book/getting-started",
              "brand-book/variables",
              "brand-book/theming",
              "brand-book/typography",
              "brand-book/light-dark-mode",
              "brand-book/components",
              "brand-book/editor",
              "brand-book/changelog"
            ]
          },
          {
            "group": "Orbital Shadcn UI Kit",
            "pages": [
              "shadcn-ui-kit/overview",
              "shadcn-ui-kit/getting-started",
              "shadcn-ui-kit/variables",
              "shadcn-ui-kit/theming",
              "shadcn-ui-kit/typography",
              "shadcn-ui-kit/light-dark-mode",
              "shadcn-ui-kit/components",
              "shadcn-ui-kit/editor",
              "shadcn-ui-kit/changelog"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Orbital Supply",
          "href": "https://www.orbital.supply",
          "icon": "globe"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@orbital.supply"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Buy Templates",
      "href": "https://www.orbital.supply/pricing"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "website": "https://www.orbital.supply",
      "linkedin": "https://www.linkedin.com/company/orbital-supply"
    }
  }
}
